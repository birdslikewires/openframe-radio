server {

    listen 5111;

    # Proxy active Icecast streams directly to clients
    location ~ ^/stream/(\d+)$ {
        proxy_pass http://127.0.0.1:8000/$1;
        proxy_buffering off;
        proxy_http_version 1.0;
        proxy_read_timeout 3600;
        gzip off;
    }

    # Stream orchestrator — starts transcoding if needed, then redirects
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/radio/stream.sh;
        fastcgi_pass unix:/run/fcgiwrap.socket;
        gzip off;
    }

}
